<Window x:Class="DeepSeekOrb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek"
        Width="420" Height="860"
        MinWidth="280" MinHeight="220"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BtnHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BtnHoverClose}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 外层玻璃框：圆角 + 1px 渐变描边 -->
        <Border x:Name="Frame" CornerRadius="14" BorderThickness="1" Background="Transparent">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#38FFFFFF" Offset="0"/>
                    <GradientStop Color="#0AFFFFFF" Offset="0.45"/>
                    <GradientStop Color="#12FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏：底层为实时抓取的桌面模糊，上层叠加色调 -->
                <Grid Grid.Row="0" x:Name="Bar"
                      MouseLeftButtonDown="Bar_MouseLeftButtonDown">

                    <Image x:Name="BarBackdrop" Stretch="Fill" IsHitTestVisible="False"/>
                    <Rectangle Fill="{DynamicResource BarTint}" IsHitTestVisible="False"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="19" Height="19" CornerRadius="6" Background="{DynamicResource Accent}">
                            <Path Fill="White" Stretch="Uniform" Margin="2">
                                <Path.Data>
                                    <GeometryGroup FillRule="EvenOdd">
                                        <EllipseGeometry Center="12,15" RadiusX="10" RadiusY="7.5"/>
                                        <PathGeometry Figures="M 22,15 L 30,9 L 30,21 Z"/>
                                        <EllipseGeometry Center="7.2,12.8" RadiusX="1.6" RadiusY="1.6"/>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                        </Border>
                        <TextBlock x:Name="TitleText" Text="DeepSeek" Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="StatusText" Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,7,0">
                        <Button x:Name="BtnBack" Style="{StaticResource IconBtn}" Content="&#xE72B;"
                                ToolTip="后退" Click="BtnBack_Click"/>
                        <Button x:Name="BtnReload" Style="{StaticResource IconBtn}" Content="&#xE72C;"
                                ToolTip="刷新" Click="BtnReload_Click"/>
                        <Button x:Name="BtnAddPane" Style="{StaticResource IconBtn}" Content="&#xE710;"
                                ToolTip="增加分屏" Click="BtnAddPane_Click"/>
                        <Button x:Name="BtnRemovePane" Style="{StaticResource IconBtn}" Content="&#xE738;"
                                ToolTip="减少分屏（关闭最后一个）" Click="BtnRemovePane_Click"/>
                        <Button x:Name="BtnPin" Style="{StaticResource IconBtn}" Content="&#xE718;"
                                ToolTip="固定窗口（不自动收起）" Click="BtnPin_Click"/>
                        <Button x:Name="BtnCollapse" Style="{StaticResource IconBtn}" Content="&#xE70D;"
                                ToolTip="收起" Click="BtnCollapse_Click"/>
                        <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" Content="&#xE8BB;"
                                ToolTip="退出" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 内容区：纵向平铺的对话区域，行间分隔条可拖动调整比例 -->
                <Border Grid.Row="1" Background="{DynamicResource PageBg}" CornerRadius="0,0,13,13">
                    <Grid x:Name="PaneHost"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
